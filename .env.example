# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# .env is gitignored - never commit it. It holds your Telegram bot token.

# ---- Telegram ----
# Get a token from @BotFather (send /newbot).
# Then run:  python setup_telegram.py   - it finds your chat ID for you.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# One chat ID, or several separated by commas.
# Group IDs are negative - keep the minus sign.
# Find a group's ID with:  python find_chat_ids.py
#   TELEGRAM_CHAT_ID=987654321,-1001234567890
TELEGRAM_CHAT_ID=987654321

# ---- Your delivery pincode ----
PINCODE=560075

# ---- Timing ----
# Bot 1 looks for newly added products.
BOT1_INTERVAL_HOURS=24

# Bot 2 checks deliverability. One cycle is ~2.5s of work and ~90KB, so 15s
# is comfortable; below ~10s you are re-reading identical numbers.
BOT2_INTERVAL_SECONDS=15

# ---- Cart behaviour ----
# Put shortlist items in the cart. Required for the bot to work at all:
# FirstCry only reveals deliverability for items sitting in the cart.
# It never buys anything.
AUTO_ADD_TO_CART=true

# Adding is retried every N checks rather than every cycle, since once
# everything is in the cart there is usually nothing to add.
ADD_TO_CART_EVERY_N_CHECKS=5

# ---- What to watch ----
# 113 = Hot Wheels. Other brands work too - find the id in the listing API.
BRAND_ID=113
